NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only keys. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# A 32-byte base64 key used by Vercel server routes to encrypt integration credentials.
INTEGRATION_SECRET_ENCRYPTION_KEY=generate-a-32-byte-base64-key
# Random secret used by Vercel Cron to process queued Magento imports.
CRON_SECRET=generate-a-long-random-secret
# Optional value to whitelist in Magento access controls.
MAGENTO_SYNC_USER_AGENT=PriceShift-Magento-Sync/1.0
